# Copiá este archivo a ".env.local" (con el punto inicial) y completá con las
# credenciales reales del proyecto de Supabase (Dashboard > Project Settings > API).
# NUNCA commitees .env.local -- ya está en .gitignore.
#
# NOTA: este archivo se llama "env.local.example" (sin punto inicial) porque
# el entorno de esta sesión bloquea la escritura de archivos que empiezan con
# ".env" como medida de seguridad anti-filtración de credenciales. Renombralo
# vos mismo a ".env.local.example" (o directamente a ".env.local" con tus
# valores reales) -- es un simple `mv`.

# Pública -- se expone al browser (prefijo NEXT_PUBLIC_ obligatorio en Next.js).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Secreta -- SOLO server-side. Bypassa RLS. Nunca prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pública -- usada para construir back_urls/notification_url absolutas para
# Mercado Pago (Checkout Pro requiere URLs públicas, no relativas).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secretas -- SOLO server-side (lib/mercadopago/client.ts, lib/mercadopago/webhook.ts).
# Sacalas del panel de Mercado Pago > Tus integraciones > [tu app] > Credenciales.
# MERCADOPAGO_WEBHOOK_SECRET es el "Webhook secret / Clave secreta" de la
# sección de notificaciones webhook de esa misma app (NO el access token).
MERCADOPAGO_ACCESS_TOKEN=your-mercadopago-access-token
MERCADOPAGO_WEBHOOK_SECRET=your-mercadopago-webhook-secret

# Pública -- embed de YouTube Live en /vivo (components/marketing/LiveStreamEmbed.tsx).
# El Channel ID de YouTube (Configuración del canal > Avanzada > ID del canal,
# empieza con "UC..."), NO el @handle. Mientras esta transmitiendo en vivo en
# ese canal, se muestra automáticamente -- no hace falta actualizar nada por
# cada sorteo.
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=your-youtube-channel-id
